<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>echooo</AssemblyName>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\start-recording.wav" />
		<None Remove="Assets\stop-recording.wav" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GregsStack.InputSimulatorStandard" Version="1.3.5" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="SharpHook" Version="7.1.1" />
		<PackageReference Include="Spectre.Console" Version="0.57.2" />
		<PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
		<PackageReference Include="TextCopy" Version="6.2.1" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
		<PackageReference Include="Whisper.net" Version="1.9.0" />
		<PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
	</ItemGroup>

	<!--
		The packages above are needed to compile the code of every system, so they are always there.
		The native libraries below belong to one system each and are chosen by the system the build is for:
		the one given with -r, or, without it (Visual Studio, dotnet test), the one the build runs on.
	-->
	<PropertyGroup>
		<TargetSystem Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</TargetSystem>
		<TargetSystem Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</TargetSystem>
		<TargetSystem Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</TargetSystem>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetSystem)' == 'win-x64'">
		<PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.0" />
		<PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetSystem)' == 'linux-x64'">
		<PackageReference Include="Whisper.net.Runtime.Cuda.Linux" Version="1.9.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\start-recording.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\stop-recording.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Echo.Tests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>
